# Command Centre — env vars (copy to ~/.command-centre/.env after install).
# install.sh seeds this file at install-time. chmod 600 after editing.

# === Server ===
CC_PORT=8765
CC_HOST=127.0.0.1
CC_LOG_LEVEL=info

# === Storage ===
# Defaults to <install-dir>/data/commandcentre.db. Override only if needed.
# CC_DB_PATH=/Users/hhalfpap/.command-centre/data/commandcentre.db

# === Time zone ===
# Optional. Empty -> system local TZ. Used for day-bucketing in queries
# and the schedule composer header.
# TZ=Europe/Berlin

# === JSONL ingest ===
# Default: ~/.claude/projects. Override if Claude Code stores sessions
# elsewhere on this host.
# CC_CLAUDE_PROJECTS_DIR=/Users/hhalfpap/.claude/projects

# Cowork sessions (optional)
# CC_COWORK_SESSIONS_DIR=/Users/hhalfpap/Library/Application Support/Claude/local-agent-mode-sessions

# === Mission Control ===
# Default model when neither task nor skill specifies one.
MISSION_CONTROL_DEFAULT_MODEL=claude-sonnet-4-6
# Maximum concurrent dispatched tasks.
MISSION_CONTROL_MAX_CONCURRENT=3
# Per-task wall-clock cap in seconds.
MISSION_CONTROL_TASK_TIMEOUT_SECONDS=1800

# === Anthropic API (optional) ===
# Used by skill_router (Haiku skill picker) and schedule NL parsing.
# When unset both features fall back to manual entry — server still runs.
# ANTHROPIC_API_KEY=sk-ant-...

# === Telegram (optional, off by default) ===
# Set both, then run: cc setup telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DASH_CHAT_ID=

# === Claude Code retry threshold ===
# PressurePanel surfaces retry-exhaustion when attempt_count >= this.
CLAUDE_CODE_MAX_RETRIES=10
